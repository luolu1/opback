# /etc/opback/agent.env  (chmod 600)

# 面板「后端」地址（Agent 接入端口，默认 8081；不是 Web UI 的 8080）
OPBACK_PANEL_URL=http://panel.example.com:8081
# 面板启用注册密钥时必填
OPBACK_ENROLL_TOKEN=CHANGE-ME-ENROLL
# 本节点在面板中显示的名称（默认主机名）
OPBACK_NAME=web1
# 状态目录（令牌、增量索引）
OPBACK_STATE_DIR=/var/lib/opback-agent
# systemd 服务名（收到面板的远程卸载指令时用于停止并移除自身，默认 opback-agent）
OPBACK_SERVICE_NAME=opback-agent
