[Unit]
Description=opback Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 若需备份 /etc、/root 等目录，需要以 root 运行（或用具有相应读权限的用户）
User=root
WorkingDirectory=/opt/opback
# -panel-url 指向面板的「后端」端口（Agent 接入端口，默认 8081），不是 Web UI 端口。
ExecStart=/opt/opback/bin/opback-agent -panel-url http://panel.example.com:8081 -state-dir /var/lib/opback-agent -service-name opback-agent
Restart=on-failure
RestartSec=5
# Let the detached uninstall helper survive when the panel removes this node.
KillMode=process
EnvironmentFile=-/etc/opback/agent.env

[Install]
WantedBy=multi-user.target
