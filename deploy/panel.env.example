# /etc/opback/panel.env  (chmod 600)
#
# 面板启动时通过 systemd 的 EnvironmentFile 读取。命令行 flag 优先级更高。
# 这里的值会在面板启动时写入/覆盖已保存的设置（仅当非空）。

# 监听地址：前端（Web UI + 管理 API）与后端（Agent 接入 + 安装脚本）已分离
# 只把后端端口暴露给需要接入的机器；前端端口建议只在内网/反代后可访问。
OPBACK_WEB_ADDR=:8080
OPBACK_AGENT_ADDR=:8081
# 兼容旧变量：OPBACK_ADDR 等价于 OPBACK_WEB_ADDR
# OPBACK_ADDR=:8080

# 可选：JSON 配置文件（也可用 -config 指定）。文件不存在时会忽略。
# OPBACK_CONFIG=/etc/opback/config.json

# 数据目录（store.json 所在）
OPBACK_DATA=/var/lib/opback

# Agent 注册密钥：留空则允许任意 Agent 注册（不建议对外）
OPBACK_ENROLL_TOKEN=CHANGE-ME-ENROLL

# OpenList 连接信息（首次启动的便捷写入，会创建/更新一个名为「默认连接」的连接；
# 之后可在 Web UI 的「OpenList 连接」页面管理多个连接）
OPBACK_OPENLIST_URL=https://your-openlist.example.com
OPBACK_OPENLIST_USER=admin
OPBACK_OPENLIST_PASS=your-openlist-password
