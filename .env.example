# opback — Docker Compose secrets.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. These values are read by the panel container at start-up
# (flag > config.json > environment), so they are never baked into the image.

# Shared secret every agent must present when registering a node.
# Leave empty to allow open registration (NOT recommended on a public host).
OPBACK_ENROLL_TOKEN=CHANGE-ME-ENROLL

# Optional: bootstrap the default OpenList connection on first start.
# You can also add more connections later in the Web UI.
# OPBACK_OPENLIST_URL=https://your-openlist.example.com
# OPBACK_OPENLIST_USER=admin
# OPBACK_OPENLIST_PASS=your-openlist-password
